+"""CLI wiring for `python -m ledgerlite alias ...` (extracted out of
+`cli.py` -- pure refactor, same commands/flags/output/exit codes)."""
+
+from __future__ import annotations
+
+import argparse
+import sys
+
+from . import aliases
+
+
+def add_subparser(sub: "argparse._SubParsersAction", default_store: str) -> None:
+    p_alias = sub.add_parser("alias", help="manage merchant aliases")
+    alias_sub = p_alias.add_subparsers(dest="alias_command", required=True)
+
+    p_alias_add = alias_sub.add_parser("add", help="add a merchant alias")
+    p_alias_add.add_argument("--pattern", required=True)
+    p_alias_add.add_argument("--canonical", required=True)
+    p_alias_add.add_argument(
+        "--store", default=default_store, help="ledger JSON file to update (default: %(default)s)"
+    )
+
+    p_alias_list = alias_sub.add_parser("list", help="list merchant aliases")
+    p_alias_list.add_argument(
+        "--store", default=default_store, help="ledger JSON file to read (default: %(default)s)"
+    )
+
+    p_alias_remove = alias_sub.add_parser("remove", help="remove a merchant alias")
+    p_alias_remove.add_argument("pattern")
+    p_alias_remove.add_argument(
+        "--store", default=default_store, help="ledger JSON file to update (default: %(default)s)"
+    )
+
+
+def _cmd_add(args: argparse.Namespace) -> int:
+    existing = aliases.load_aliases(args.store)
+    existing.append((args.pattern, args.canonical))
+    aliases.save_aliases(args.store, existing)
+    print(f"Added alias {args.pattern} -> {args.canonical}")
+    return 0
+
+
+def _cmd_list(args: argparse.Namespace) -> int:
+    existing = aliases.load_aliases(args.store)
+    if not existing:
+        print("No aliases.")
+        return 0
+    for pattern, canonical in existing:
+        print(f"{pattern} -> {canonical}")
+    return 0
+
+
+def _cmd_remove(args: argparse.Namespace) -> int:
+    existing = aliases.load_aliases(args.store)
+    remaining = [(p, c) for p, c in existing if p != args.pattern]
+    if len(remaining) == len(existing):
+        print(f"no alias with pattern {args.pattern!r}", file=sys.stderr)
+        return 2
+    aliases.save_aliases(args.store, remaining)
+    print(f"Removed alias {args.pattern}")
+    return 0
+
+
+def handle(args: argparse.Namespace) -> int:
+    if args.alias_command == "add":
+        return _cmd_add(args)
+    if args.alias_command == "list":
+        return _cmd_list(args)
+    if args.alias_command == "remove":
+        return _cmd_remove(args)
+    print(f"unknown alias subcommand: {args.alias_command}", file=sys.stderr)
+    return 2
