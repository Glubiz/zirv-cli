@@ -0,0 +1,59 @@
+"""Merchant (and, by reuse, category) alias resolution and persistence.
+
+An alias is a `(pattern, canonical)` pair: any raw payee (or category)
+containing `pattern` resolves to `canonical`. Aliases are stored as a plain
+ordered list -- the FIRST matching alias wins, so insertion order is
+significant and preserved by every persistence helper below.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import List, Tuple, Union
+
+from . import store
+
+Alias = Tuple[str, str]
+
+ALIASES_KEY = "aliases"
+CATEGORY_ALIASES_KEY = "category_aliases"
+
+
+def resolve_alias(name: str, aliases: List[Alias]) -> str:
+    """Return the canonical name for `name` (a payee or category).
+
+    Checks `aliases` in order; the first whose `pattern` is a
+    case-insensitive substring of `name` wins (same case-folding as the
+    "substring" rule kind in `rules.py`). Returns `name` unchanged if no
+    alias matches.
+    """
+    lowered = name.lower()
+    for pattern, canonical in aliases:
+        if pattern.lower() in lowered:
+            return canonical
+    return name
+
+
+def _load(path: Union[str, Path], key: str) -> List[Alias]:
+    raw = store.load_key(path, key, default=[])
+    return [(item[0], item[1]) for item in raw]
+
+
+def _save(path: Union[str, Path], key: str, aliases: List[Alias]) -> None:
+    store.save_key(path, key, [[pattern, canonical] for pattern, canonical in aliases])
+
+
+def load_aliases(path: Union[str, Path]) -> List[Alias]:
+    return _load(path, ALIASES_KEY)
+
+
+def save_aliases(path: Union[str, Path], aliases: List[Alias]) -> None:
+    _save(path, ALIASES_KEY, aliases)
+
+
+def load_category_aliases(path: Union[str, Path]) -> List[Alias]:
+    return _load(path, CATEGORY_ALIASES_KEY)
+
+
+def save_category_aliases(path: Union[str, Path], aliases: List[Alias]) -> None:
+    _save(path, CATEGORY_ALIASES_KEY, aliases)
