+"""Merchant (and, by reuse, category) alias resolution and persistence.
+
+An alias is a `(pattern, canonical)` pair: any raw payee (or category)
+containing `pattern` resolves to `canonical`. Aliases are stored as a plain
+ordered list -- the FIRST matching alias wins, so insertion order is
+significant and preserved by every persistence helper below.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import List, Tuple, Union
+
+from . import store
+
+Alias = Tuple[str, str]
+
+ALIASES_KEY = "aliases"
+
+
+def resolve_alias(name: str, aliases: List[Alias]) -> str:
+    """Return the canonical name for `name` (a payee or category).
+
+    Checks `aliases` in order; the first whose `pattern` appears as a
+    substring of `name` wins. Returns `name` unchanged if no alias matches.
+    """
+    for pattern, canonical in aliases:
+        if pattern in name:
+            return canonical
+    return name
+
+
+def load_aliases(path: Union[str, Path]) -> List[Alias]:
+    raw = store.load_key(path, ALIASES_KEY, default=[])
+    return [(item[0], item[1]) for item in raw]
+
+
+def save_aliases(path: Union[str, Path], aliases: List[Alias]) -> None:
+    store.save_key(path, ALIASES_KEY, [[pattern, canonical] for pattern, canonical in aliases])
