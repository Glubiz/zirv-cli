+def _load_raw(path: Union[str, Path]) -> dict:
+    """The whole store file as a dict, or `{}` if it does not exist yet (or
+    does not parse as a JSON object)."""
+    p = Path(path)
+    if not p.exists():
+        return {}
+    try:
+        payload = json.loads(p.read_text(encoding="utf-8"))
+    except (json.JSONDecodeError, OSError):
+        return {}
+    return payload if isinstance(payload, dict) else {}
+
+
+def _write_raw(path: Union[str, Path], payload: dict) -> None:
     Path(path).write_text(json.dumps(payload, indent=2), encoding="utf-8")
 
 
+def save(path: Union[str, Path], txns: List[Transaction]) -> None:
+    """Write `txns` to `path` as JSON, overwriting any existing file.
+
+    Merges onto whatever else is already stored at `path` (e.g. an
+    `"aliases"` key another part of ledgerlite persists there) instead of
+    clobbering it -- only the `"transactions"` key is replaced.
+    """
+    raw = _load_raw(path)
+    raw["transactions"] = [_txn_to_dict(t) for t in txns]
+    _write_raw(path, raw)
+
+
 def load(path: Union[str, Path]) -> List[Transaction]:
     """Read a list of `Transaction` from a JSON file written by `save`."""
-    payload = json.loads(Path(path).read_text(encoding="utf-8"))
-    return [_txn_from_dict(d) for d in payload.get("transactions", [])]
+    raw = _load_raw(path)
+    return [_txn_from_dict(d) for d in raw.get("transactions", [])]
+
+
+def load_key(path: Union[str, Path], key: str, default: Any = None) -> Any:
+    """Read one top-level key from the store file, `default` if absent."""
+    raw = _load_raw(path)
+    return raw.get(key, [] if default is None else default)
+
+
+def save_key(path: Union[str, Path], key: str, value: Any) -> None:
+    """Write one top-level key into the store file, preserving every other
+    key already there (`"transactions"` included)."""
+    raw = _load_raw(path)
+    raw[key] = value
+    _write_raw(path, raw)
