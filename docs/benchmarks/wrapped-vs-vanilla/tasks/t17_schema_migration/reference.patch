diff --git a/ledgerlite/schema.py b/ledgerlite/schema.py
new file mode 100644
index 0000000..790dbc2
--- /dev/null
+++ b/ledgerlite/schema.py
@@ -0,0 +1,25 @@
+"""Store JSON schema versioning and migration for ledgerlite."""
+
+from __future__ import annotations
+
+CURRENT_VERSION = 2
+
+
+def migrate_payload(payload: dict) -> dict:
+    """Return `payload` upgraded to `CURRENT_VERSION`, without mutating it.
+
+    Any transaction dict missing a `"source"` key is given
+    `source="import"` (the only way a transaction could have entered an
+    older, pre-versioned ledger file). An existing `"source"` value is left
+    untouched.
+    """
+    transactions = []
+    for txn in payload.get("transactions", []):
+        txn = dict(txn)
+        txn.setdefault("source", "import")
+        transactions.append(txn)
+
+    result = dict(payload)
+    result["schema_version"] = CURRENT_VERSION
+    result["transactions"] = transactions
+    return result
