index 0000000..125b270
--- /dev/null
+++ b/ledgerlite/tagging.py
@@ -0,0 +1,27 @@
+"""Tag normalization helpers for ledgerlite."""
+
+from __future__ import annotations
+
+from typing import Iterable, List
+
+
+def normalize_tags(raw: Iterable[str]) -> List[str]:
+    """Normalize an iterable of tag strings.
+
+    Each tag is stripped of surrounding whitespace and lowercased; blank
+    tags (empty after stripping) are dropped; duplicates are removed; the
+    result is sorted alphabetically.
+    """
+    seen = set()
+    for item in raw:
+        tag = item.strip().lower()
+        if tag:
+            seen.add(tag)
+    return sorted(seen)
+
+
+def parse_tag_list(text: str) -> List[str]:
+    """Parse a comma-separated tag string into a normalized tag list."""
+    if not text:
+        return []
+    return normalize_tags(text.split(","))
