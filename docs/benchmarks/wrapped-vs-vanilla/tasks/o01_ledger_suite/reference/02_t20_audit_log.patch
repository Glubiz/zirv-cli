+"""Append-only audit trail for ledgerlite store files."""
+
+from __future__ import annotations
+
+import json
+from dataclasses import dataclass
+from pathlib import Path
+from typing import List, Union
+
+
+@dataclass
+class AuditEntry:
+    sequence: int
+    action: str
+    detail: str
+
+
+def _load_raw(path) -> dict:
+    p = Path(path)
+    if not p.exists():
+        return {}
+    return json.loads(p.read_text(encoding="utf-8"))
+
+
+def _save_raw(path, raw: dict) -> None:
+    Path(path).write_text(json.dumps(raw, indent=2), encoding="utf-8")
+
+
+def append_entry(path: Union[str, Path], action: str, detail: str) -> AuditEntry:
+    """Append a new audit entry to the store at `path`; return it."""
+    raw = _load_raw(path)
+    existing = raw.get("audit", [])
+    entry = AuditEntry(sequence=len(existing) + 1, action=action, detail=detail)
+    existing.append({"sequence": entry.sequence, "action": entry.action, "detail": entry.detail})
+    raw["audit"] = existing
+    _save_raw(path, raw)
+    return entry
+
+
+def read_log(path: Union[str, Path]) -> List[AuditEntry]:
+    """Return every audit entry stored at `path`, oldest first."""
+    raw = _load_raw(path)
+    return [AuditEntry(sequence=e["sequence"], action=e["action"], detail=e["detail"])
+            for e in raw.get("audit", [])]
