+def _load_raw(path) -> dict:
+    p = Path(path)
+    if not p.exists():
+        return {}
+    return json.loads(p.read_text(encoding="utf-8"))
+
+
+def _save_raw(path, raw) -> None:
+    Path(path).write_text(json.dumps(raw, indent=2), encoding="utf-8")
+
+
+def _goal_to_dict(goal: Goal) -> dict:
+    return {
+        "name": goal.name,
+        "target": str(goal.target),
+        "categories": list(goal.categories),
+        "target_date": goal.target_date.isoformat() if goal.target_date else None,
+        "milestones": list(goal.milestones),
+    }
+
+
+def _goal_from_dict(data: dict) -> Goal:
+    target_date = data.get("target_date")
+    return Goal(
+        name=data["name"],
+        target=Decimal(data["target"]),
+        categories=list(data.get("categories") or []),
+        target_date=date_cls.fromisoformat(target_date) if target_date else None,
+        milestones=list(data.get("milestones") or []),
+    )
+
+
+def _load_goals(path) -> list:
+    raw = _load_raw(path)
+    return [_goal_from_dict(g) for g in raw.get("goals", [])]
+
+
+def _save_goals(path, goals) -> None:
+    raw = _load_raw(path)
+    raw["goals"] = [_goal_to_dict(g) for g in goals]
+    _save_raw(path, raw)
+
+
+def _load_txns_for_goals(path):
+    try:
+        return load(path)
+    except FileNotFoundError:
+        return []
+
+
+def _cmd_goal_add(args: argparse.Namespace) -> int:
+    target = Decimal(args.target)
+    if target <= 0:
+        print("error: --target must be strictly positive", file=sys.stderr)
+        return 2
+    goals = _load_goals(args.store)
+    if any(g.name == args.name for g in goals):
+        print(f"error: a goal named {args.name!r} already exists", file=sys.stderr)
+        return 2
+    goal = Goal(
+        name=args.name,
+        target=target,
+        categories=list(args.categories),
+        target_date=date_cls.fromisoformat(args.target_date) if args.target_date else None,
+        milestones=sorted(set(args.milestones)),
+    )
+    goals.append(goal)
+    _save_goals(args.store, goals)
+    print(f"Added goal {goal.name}")
+    return 0
+
+
+def _cmd_goal_list(args: argparse.Namespace) -> int:
+    goals = _load_goals(args.store)
+    if not goals:
+        print("No goals.")
+        return 0
+    for goal in goals:
+        line = f"{goal.name}: target {goal.target} categories {','.join(goal.categories)}"
+        if goal.target_date:
+            line += f" by {goal.target_date.isoformat()}"
+        print(line)
+    return 0
+
+
+def _find_goal(goals, name):
+    for goal in goals:
+        if goal.name == name:
+            return goal
+    return None
+
+
+def _cmd_goal_progress(args: argparse.Namespace) -> int:
+    goals = _load_goals(args.store)
+    goal = _find_goal(goals, args.name)
+    if goal is None:
+        print(f"error: no goal named {args.name!r}", file=sys.stderr)
+        return 2
+    txns = _load_txns_for_goals(args.store)
+    amount = goal_progress(goal, txns)
+    percent = (amount / goal.target * 100) if goal.target else Decimal("0")
+    line = f"{goal.name}: {amount:.2f}/{goal.target:.2f} ({percent:.1f}%)"
+    if goal.milestones:
+        reached = reached_milestones(goal, txns)
+        reached_str = ",".join(str(m) for m in reached) if reached else "none"
+        line += f" milestones reached: {reached_str}"
+    print(line)
+    return 0
+
+
+def _cmd_goal_report(args: argparse.Namespace) -> int:
+    goals = _load_goals(args.store)
+    txns = _load_txns_for_goals(args.store)
+
+    rows = []
+    for goal in goals:
+        amount = goal_progress(goal, txns)
+        percent = (amount / goal.target * 100) if goal.target else Decimal("0")
+        rows.append((goal, amount, percent))
+    rows.sort(key=lambda r: (-r[2], r[0].name))
+
+    print(f"{'Goal':<16}Progress")
+    for goal, amount, percent in rows:
+        print(f"{goal.name:<16}{percent:>6.1f}%  {amount:.2f}/{goal.target:.2f}")
+
+    if args.overall:
+        total_progress = sum((r[1] for r in rows), Decimal("0"))
+        total_target = sum((r[0].target for r in rows), Decimal("0"))
+        overall_percent = (total_progress / total_target * 100) if total_target else Decimal("0")
+        print(f"TOTAL: {overall_percent:.1f}%")
+    return 0
+
+
+def _cmd_goal_remove(args: argparse.Namespace) -> int:
+    goals = _load_goals(args.store)
+    goal = _find_goal(goals, args.name)
+    if goal is None:
+        print(f"error: no goal named {args.name!r}", file=sys.stderr)
+        return 2
+    goals = [g for g in goals if g.name != args.name]
+    _save_goals(args.store, goals)
+    print(f"Removed goal {goal.name}")
+    return 0
+
+
+def _cmd_goal(args: argparse.Namespace) -> int:
+    handler = {
+        "add": _cmd_goal_add,
+        "list": _cmd_goal_list,
+        "progress": _cmd_goal_progress,
+        "report": _cmd_goal_report,
+        "remove": _cmd_goal_remove,
+    }[args.goal_command]
+    return handler(args)
+
+
 _HANDLERS = {
     "import": _cmd_import,
     "list": _cmd_list,
     "summary": _cmd_summary,
     "categorize": _cmd_categorize,
+    "goal": _cmd_goal,
     "search": _cmd_search,
     "envelope": cmd_envelope,
     "audit": _cmd_audit,
