@@ -0,0 +1,59 @@
+"""JSON persistence for `Envelope`s, under the `"envelopes"` key of the same
+store file `ledgerlite.store` uses for transactions."""
+
+from __future__ import annotations
+
+import json
+from decimal import Decimal
+from pathlib import Path
+from typing import List, Union
+
+from .envelopes import Envelope
+
+
+def _load_raw(path: Union[str, Path]) -> dict:
+    p = Path(path)
+    if not p.exists():
+        return {}
+    return json.loads(p.read_text(encoding="utf-8"))
+
+
+def _save_raw(path: Union[str, Path], raw: dict) -> None:
+    Path(path).write_text(json.dumps(raw, indent=2), encoding="utf-8")
+
+
+def _to_dict(env: Envelope) -> dict:
+    return {
+        "name": env.name,
+        "categories": list(env.categories),
+        "monthly_budget": str(env.monthly_budget),
+        "start_month": env.start_month,
+        "rollover": env.rollover,
+        "starting_balance": str(env.starting_balance),
+        "closed_through": env.closed_through,
+        "adjustments": {k: str(v) for k, v in env.adjustments.items()},
+    }
+
+
+def _from_dict(data: dict) -> Envelope:
+    return Envelope(
+        name=data["name"],
+        categories=list(data.get("categories") or []),
+        monthly_budget=Decimal(data["monthly_budget"]),
+        start_month=data["start_month"],
+        rollover=bool(data.get("rollover", False)),
+        starting_balance=Decimal(data.get("starting_balance", "0")),
+        closed_through=data.get("closed_through"),
+        adjustments={k: Decimal(v) for k, v in (data.get("adjustments") or {}).items()},
+    )
+
+
+def load_envelopes(path: Union[str, Path]) -> List[Envelope]:
+    raw = _load_raw(path)
+    return [_from_dict(d) for d in raw.get("envelopes", [])]
+
+
+def save_envelopes(path: Union[str, Path], envelopes: List[Envelope]) -> None:
+    raw = _load_raw(path)
+    raw["envelopes"] = [_to_dict(e) for e in envelopes]
+    _save_raw(path, raw)
