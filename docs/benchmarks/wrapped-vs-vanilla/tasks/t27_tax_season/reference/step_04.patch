index 0000000..048656e
--- /dev/null
+++ b/ledgerlite/rulebook.py
@@ -0,0 +1,69 @@
+"""User-defined categorisation rules, stored in the ledger file under `rules`."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+from typing import List, Optional, Union
+
+from .models import Transaction
+from .rules import DEFAULT_RULES, categorize
+from .store import load_section, save_section
+
+
+@dataclass
+class UserRule:
+    id: int
+    pattern: str
+    category: str
+    priority: int = 0
+
+
+def load_rules(path: Union[str, Path]) -> List[UserRule]:
+    if not Path(path).exists():
+        return []
+    return [
+        UserRule(d["id"], d["pattern"], d["category"], d.get("priority", 0))
+        for d in load_section(path, "rules", [])
+    ]
+
+
+def save_rules(path: Union[str, Path], rules: List[UserRule]) -> None:
+    save_section(
+        path,
+        "rules",
+        [
+            {"id": r.id, "pattern": r.pattern, "category": r.category, "priority": r.priority}
+            for r in rules
+        ],
+    )
+
+
+def add_rule(rules: List[UserRule], pattern: str, category: str, priority: int = 0) -> UserRule:
+    rule = UserRule(max((r.id for r in rules), default=0) + 1, pattern, category, priority)
+    rules.append(rule)
+    return rule
+
+
+def rule_matches(rule: UserRule, txn: Transaction) -> bool:
+    needle = rule.pattern.lower()
+    return needle in txn.payee.lower() or needle in txn.memo.lower()
+
+
+def _resolution_key(rule: UserRule):
+    # Highest priority first; then the longer (more specific) pattern; then
+    # the lowest id (added first).
+    return (-rule.priority, -len(rule.pattern), rule.id)
+
+
+def matching_rules(txn: Transaction, rules: List[UserRule]) -> List[UserRule]:
+    """Every user rule matching `txn`, best (winning) rule first."""
+    return sorted((r for r in rules if rule_matches(r, txn)), key=_resolution_key)
+
+
+def categorize_txn(txn: Transaction, rules: List[UserRule]) -> Optional[str]:
+    """User rules first (they always beat the built-in defaults), then defaults."""
+    matches = matching_rules(txn, rules)
+    if matches:
+        return matches[0].category
+    return categorize(txn, DEFAULT_RULES)
diff --git a/ledgerlite/splits.py b/ledgerlite/splits.py
new file mode 100644
index 0000000..8addb7c
--- /dev/null
+++ b/ledgerlite/splits.py
@@ -0,0 +1,51 @@
+"""Split a transaction across several categories."""
+
+from __future__ import annotations
+
+from decimal import ROUND_DOWN, ROUND_HALF_UP, Decimal
+from typing import List, Tuple
+
+CENT = Decimal("0.01")
+
+
+def allocate(amount: Decimal, percents: List[Decimal]) -> List[Decimal]:
+    """Divide `amount` into parts by `percents` (which sum to 100), in whole cents.
+
+    Each part is floor(|amount| in cents * percent / 100) cents; the cents
+    left over (always fewer than the number of parts) are handed out one
+    each to the first parts, in the order given. Parts carry `amount`'s sign
+    and always sum to exactly `amount`.
+    """
+    cents = int((abs(amount) * 100).to_integral_value(ROUND_HALF_UP))
+    shares = [int((Decimal(cents) * p / 100).to_integral_value(ROUND_DOWN)) for p in percents]
+    for i in range(cents - sum(shares)):
+        shares[i] += 1
+    sign = -1 if amount < 0 else 1
+    return [(Decimal(s) / 100 * sign).quantize(CENT) for s in shares]
+
+
+def parse_part(text: str) -> Tuple[str, Decimal]:
+    """Parse ``CATEGORY=PERCENT`` into (category, percent)."""
+    category, sep, pct = text.partition("=")
+    category = category.strip()
+    try:
+        percent = Decimal(pct.strip())
+    except Exception:
+        percent = Decimal(0)
+    if not sep or not category or percent <= 0:
+        raise ValueError(text)
+    return category, percent
+
+
+def build_splits(amount: Decimal, parts: List[Tuple[str, Decimal]]) -> List[dict]:
+    amounts = allocate(amount, [p for _, p in parts])
+    return [
+        {"category": c, "percent": str(p), "amount": str(a)}
+        for (c, p), a in zip(parts, amounts)
+    ]
+
+
+def reallocate(amount: Decimal, splits: List[dict]) -> List[dict]:
+    """Re-run the allocation for a new `amount` using the stored percents."""
+    parts = [(s["category"], Decimal(s["percent"])) for s in splits]
+    return build_splits(amount, parts)
