@@ -0,0 +1,28 @@
+"""Duplicate detection for incoming transactions."""
+
+from __future__ import annotations
+
+from typing import List
+
+from .merchants import normalize_payee
+from .models import Transaction
+
+DEFAULT_WINDOW_DAYS = 2
+
+
+def _same_merchant(a: Transaction, b: Transaction) -> bool:
+    return normalize_payee(a.payee).casefold() == normalize_payee(b.payee).casefold()
+
+
+def is_duplicate(
+    incoming: Transaction, existing: List[Transaction], window_days: int = DEFAULT_WINDOW_DAYS
+) -> bool:
+    """True if `existing` holds a transaction with the same normalised payee
+    (case-insensitive) and exactly the same amount, dated within
+    `window_days` days of `incoming`."""
+    return any(
+        _same_merchant(incoming, e)
+        and incoming.amount == e.amount
+        and abs((incoming.date - e.date).days) <= window_days
+        for e in existing
+    )
