+"""Merchant-name normalisation for ledgerlite."""
+
+from __future__ import annotations
+
+import re
+
+_STORE_NUMBER = re.compile(r"#\d+")
+_TRAILING_REF = re.compile(r"\d{3,}")
+
+
+def normalize_payee(raw: str) -> str:
+    """Return the canonical form of a statement payee.
+
+    Collapses whitespace, drops ``#123``-style store-number tokens, drops a
+    trailing all-digit token of three or more digits (when something else
+    remains). Case is preserved. If that would leave nothing, the
+    whitespace-collapsed input is returned instead.
+    """
+    cleaned = " ".join(raw.split())
+    tokens = [t for t in cleaned.split(" ") if t and not _STORE_NUMBER.fullmatch(t)]
+    if len(tokens) > 1 and _TRAILING_REF.fullmatch(tokens[-1]):
+        tokens.pop()
+    return " ".join(tokens) or cleaned
