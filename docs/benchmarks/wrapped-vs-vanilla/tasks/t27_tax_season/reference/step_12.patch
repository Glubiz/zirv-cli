+"""Receipt metadata: where a receipt file lives and its checksum.
+
+The ledger only stores the path and a SHA-256 of the file's bytes, never
+the file itself.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+
+
+def sha256_of(path: str) -> str:
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def make_receipt(path: str) -> dict:
+    return {"path": path, "sha256": sha256_of(path)}
+
+
+def check_receipt(receipt: dict) -> str:
+    """Return OK, MISSING (file gone) or MISMATCH (file changed)."""
+    if not Path(receipt["path"]).is_file():
+        return "MISSING"
+    return "OK" if sha256_of(receipt["path"]) == receipt["sha256"] else "MISMATCH"
