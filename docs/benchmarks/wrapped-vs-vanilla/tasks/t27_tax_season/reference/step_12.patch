@@ -0,0 +1,42 @@
+"""Duplicate detection for incoming transactions."""
+
+from __future__ import annotations
+
+from typing import List, Optional, Set
+
+from .merchants import normalize_payee
+from .models import Transaction
+
+DEFAULT_WINDOW_DAYS = 2
+
+
+def _same_merchant(a: Transaction, b: Transaction) -> bool:
+    return normalize_payee(a.payee).casefold() == normalize_payee(b.payee).casefold()
+
+
+def find_match(
+    incoming: Transaction,
+    existing: List[Transaction],
+    window_days: int = DEFAULT_WINDOW_DAYS,
+    used: Optional[Set[int]] = None,
+) -> Optional[int]:
+    """Index into `existing` of the transaction `incoming` duplicates, or None.
+
+    A match has the same normalised payee (case-insensitive) and exactly the
+    same amount, dated within `window_days` days. Indexes in `used` were
+    already claimed by an earlier incoming row and are skipped, so each
+    existing transaction absorbs at most one incoming row. Among several
+    candidates the closest date wins, then the lowest id.
+    """
+    used = used or set()
+    best = None
+    for index, e in enumerate(existing):
+        if index in used or not _same_merchant(incoming, e) or incoming.amount != e.amount:
+            continue
+        gap = abs((incoming.date - e.date).days)
+        if gap > window_days:
+            continue
+        key = (gap, e.id)
+        if best is None or key < best[0]:
+            best = (key, index)
+    return None if best is None else best[1]
