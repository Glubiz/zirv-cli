+"""Data-validation checks over a ledger."""
+
+from __future__ import annotations
+
+from collections import Counter
+from decimal import Decimal
+from typing import List, Tuple
+
+from .models import Transaction
+
+
+def find_issues(txns: List[Transaction]) -> List[Tuple[int, str]]:
+    """Return (id, code) for every problem found, sorted by id then code."""
+    issues: List[Tuple[int, str]] = []
+    for txn_id, count in Counter(t.id for t in txns).items():
+        if count > 1:
+            issues.append((txn_id, "duplicate-id"))
+    for txn in txns:
+        if txn.splits and sum(Decimal(p["amount"]) for p in txn.splits) != txn.amount:
+            issues.append((txn.id, "split-mismatch"))
+        if txn.deductible and txn.category is None and not txn.splits:
+            issues.append((txn.id, "uncategorized-deductible"))
+    return sorted(issues)
