+++ b/ledgerlite/taxes.py
@@ -0,0 +1,42 @@
+"""Tax-year reporting over the transactions flagged tax-deductible."""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+from typing import Dict, List, Tuple
+
+from .models import Transaction
+from .report import UNCATEGORIZED
+
+
+def deductible_by_category(
+    txns: List[Transaction], start: date, end: date
+) -> Dict[str, Decimal]:
+    """Total deductible spending per category for dates in [start, end].
+
+    Only flagged transactions with money out (negative amount) count, each
+    as a positive number. A split transaction contributes each of its parts
+    to that part's own category.
+    """
+    totals: Dict[str, Decimal] = {}
+    for txn in txns:
+        if not txn.deductible or txn.amount >= 0 or not (start <= txn.date <= end):
+            continue
+        if txn.splits:
+            for part in txn.splits:
+                key = part["category"]
+                totals[key] = totals.get(key, Decimal("0")) + abs(Decimal(part["amount"]))
+        else:
+            key = txn.category or UNCATEGORIZED
+            totals[key] = totals.get(key, Decimal("0")) + abs(txn.amount)
+    return totals
+
+
+def tax_year_bounds(year: int) -> Tuple[date, date]:
+    return date(year, 1, 1), date(year, 12, 31)
+
+
+def summary_rows(totals: Dict[str, Decimal]) -> List[Tuple[str, Decimal]]:
+    """Biggest amount first; equal amounts by category name."""
+    return sorted(totals.items(), key=lambda item: (-item[1], item[0]))
