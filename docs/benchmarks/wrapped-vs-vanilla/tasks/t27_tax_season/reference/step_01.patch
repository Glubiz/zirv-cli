--- a/ledgerlite/store.py
+++ b/ledgerlite/store.py
@@ -6,7 +6,7 @@ import json
 from datetime import date
 from decimal import Decimal
 from pathlib import Path
-from typing import List, Union
+from typing import Any, List, Union
 
 from .models import Transaction
 
@@ -33,13 +33,38 @@ def _txn_from_dict(data: dict) -> Transaction:
     )
 
 
-def save(path: Union[str, Path], txns: List[Transaction]) -> None:
-    """Write `txns` to `path` as JSON, overwriting any existing file."""
-    payload = {"transactions": [_txn_to_dict(t) for t in txns]}
+def _read_payload(path: Union[str, Path]) -> dict:
+    """Return the whole JSON document at `path`, or {} if there is no file yet."""
+    p = Path(path)
+    if not p.exists():
+        return {}
+    return json.loads(p.read_text(encoding="utf-8"))
+
+
+def _write_payload(path: Union[str, Path], payload: dict) -> None:
     Path(path).write_text(json.dumps(payload, indent=2), encoding="utf-8")
 
 
+def save(path: Union[str, Path], txns: List[Transaction]) -> None:
+    """Write `txns` to `path` as JSON, keeping every other top-level key."""
+    payload = _read_payload(path)
+    payload["transactions"] = [_txn_to_dict(t) for t in txns]
+    _write_payload(path, payload)
+
+
 def load(path: Union[str, Path]) -> List[Transaction]:
     """Read a list of `Transaction` from a JSON file written by `save`."""
     payload = json.loads(Path(path).read_text(encoding="utf-8"))
     return [_txn_from_dict(d) for d in payload.get("transactions", [])]
+
+
+def load_section(path: Union[str, Path], key: str, default: Any) -> Any:
+    """Return the top-level `key` of the store at `path`, or `default`."""
+    return _read_payload(path).get(key, default)
+
+
+def save_section(path: Union[str, Path], key: str, value: Any) -> None:
+    """Set top-level `key` in the store at `path`, keeping everything else."""
+    payload = _read_payload(path)
+    payload[key] = value
+    _write_payload(path, payload)
