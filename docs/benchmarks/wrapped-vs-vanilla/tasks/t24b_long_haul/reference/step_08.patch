+
+
+def _cmd_report(args: argparse.Namespace) -> int:
+    if args.report_command == "cashflow":
+        txns = load(args.store)
+        from_year, from_month = _parse_year_month(args.from_month)
+        to_year, to_month = _parse_year_month(args.to_month)
+        rows = report.cashflow(txns, from_year, from_month, to_year, to_month)
+        print(f"{'Month':<7}  {'Income':>10}  {'Expense':>10}  {'Net':>10}")
+        for month, income, expense, net in rows:
+            print(f"{month:<7}  {income:>10.2f}  {expense:>10.2f}  {net:>10.2f}")
+        return 0
+    raise ValueError(f"unknown report command: {args.report_command!r}")
+
+
+HANDLERS = {"report": _cmd_report}
