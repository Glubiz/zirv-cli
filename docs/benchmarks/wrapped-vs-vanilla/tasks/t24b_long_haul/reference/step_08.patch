+
+def cashflow(
+    txns: List[Transaction], from_year: int, from_month: int, to_year: int, to_month: int
+) -> List[Tuple[str, Decimal, Decimal, Decimal]]:
+    """Monthly income/expense/net for every calendar month in the inclusive
+    range, in chronological order -- including months with no activity at
+    all (all three figures `Decimal("0")`).
+
+    `income` sums positive amounts, `expense` sums the absolute value of
+    negative amounts (so it is reported as a positive figure), and
+    `net = income - expense` (equivalently, the sum of the raw signed
+    amounts for that month).
+    """
+    by_month: Dict[str, Tuple[Decimal, Decimal]] = {}
+    for txn in txns:
+        key = f"{txn.date.year:04d}-{txn.date.month:02d}"
+        income, expense = by_month.get(key, (Decimal("0"), Decimal("0")))
+        if txn.amount >= 0:
+            income += txn.amount
+        else:
+            expense += -txn.amount
+        by_month[key] = (income, expense)
+
+    rows = []
+    for year, month in _months_in_range(from_year, from_month, to_year, to_month):
+        key = f"{year:04d}-{month:02d}"
+        income, expense = by_month.get(key, (Decimal("0"), Decimal("0")))
+        rows.append((key, income, expense, income - expense))
+    return rows
+
