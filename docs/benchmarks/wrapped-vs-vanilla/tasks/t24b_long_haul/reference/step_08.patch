+"""The `recurring` command family."""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from decimal import Decimal
+
+from ..recurring import RecurringRule, generate, load_rules, save_rules
+from ..store import load, next_id, save
+from . import DEFAULT_STORE
+from .core import _parse_year_month
+
+
+def add_subparser(sub: argparse._SubParsersAction) -> None:
+    p_recurring = sub.add_parser("recurring", help="recurring transaction rules")
+    recurring_sub = p_recurring.add_subparsers(dest="recurring_command", required=True)
+
+    p_rec_add = recurring_sub.add_parser("add", help="add a recurring rule")
+    p_rec_add.add_argument("--payee", required=True)
+    p_rec_add.add_argument("--amount", required=True)
+    p_rec_add.add_argument("--day", type=int, required=True, help="day of month, 1-28")
+    p_rec_add.add_argument("--category", default=None)
+    p_rec_add.add_argument("--currency", default="USD")
+    p_rec_add.add_argument("--memo", default="")
+    p_rec_add.add_argument("--store", default=DEFAULT_STORE)
+
+    p_rec_list = recurring_sub.add_parser("list", help="list recurring rules")
+    p_rec_list.add_argument("--store", default=DEFAULT_STORE)
+
+    p_rec_apply = recurring_sub.add_parser(
+        "apply", help="generate transactions for a month range and add them to the store"
+    )
+    p_rec_apply.add_argument("--from", dest="from_month", required=True, metavar="YYYY-MM")
+    p_rec_apply.add_argument("--to", dest="to_month", required=True, metavar="YYYY-MM")
+    p_rec_apply.add_argument("--store", default=DEFAULT_STORE)
+
+
+def _cmd_recurring(args: argparse.Namespace) -> int:
+    if args.recurring_command == "add":
+        if not (1 <= args.day <= 28):
+            print(f"error: --day must be between 1 and 28, got {args.day}", file=sys.stderr)
+            return 2
+        rules = load_rules(args.store)
+        rules.append(RecurringRule(
+            payee=args.payee, amount=Decimal(args.amount), day=args.day,
+            category=args.category, currency=args.currency, memo=args.memo,
+        ))
+        save_rules(args.store, rules)
+        print(f"Added recurring {args.payee}: {Decimal(args.amount)} on day {args.day}")
+        return 0
+    if args.recurring_command == "list":
+        rules = load_rules(args.store)
+        if not rules:
+            print("No recurring rules.")
+            return 0
+        for rule in rules:
+            print(f"{rule.payee}: {rule.amount} {rule.currency} day {rule.day}")
+        return 0
+    if args.recurring_command == "apply":
+        rules = load_rules(args.store)
+        existing = load(args.store)
+        from_year, from_month = _parse_year_month(args.from_month)
+        to_year, to_month = _parse_year_month(args.to_month)
+        new_txns = generate(
+            rules, from_year, from_month, to_year, to_month,
+            start_id=next_id(existing),
+        )
+        save(args.store, existing + new_txns)
+        print(f"Applied {len(new_txns)} recurring transactions")
+        return 0
+    raise ValueError(f"unknown recurring command: {args.recurring_command!r}")
+
+
+HANDLERS = {"recurring": _cmd_recurring}
