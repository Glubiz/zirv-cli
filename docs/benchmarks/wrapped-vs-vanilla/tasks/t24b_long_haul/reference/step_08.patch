@@ -0,0 +1,28 @@
+"""Bank reconciliation for ledgerlite: marking transactions as cleared and
+comparing their total against a bank statement balance."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+from pathlib import Path
+from typing import List, Set, Union
+
+from . import store
+from .models import Transaction
+
+CLEARED_KEY = "cleared_ids"
+
+
+def load_cleared(path: Union[str, Path]) -> Set[int]:
+    raw = store.load_key(path, CLEARED_KEY, default=[])
+    return set(raw)
+
+
+def mark_cleared(path: Union[str, Path], ids: List[int]) -> None:
+    cleared = load_cleared(path)
+    cleared.update(ids)
+    store.save_key(path, CLEARED_KEY, sorted(cleared))
+
+
+def cleared_total(txns: List[Transaction], cleared_ids: Set[int]) -> Decimal:
+    return sum((t.amount for t in txns if t.id in cleared_ids), Decimal("0"))
