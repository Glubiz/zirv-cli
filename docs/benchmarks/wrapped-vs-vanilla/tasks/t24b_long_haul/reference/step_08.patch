@@ -0,0 +1,70 @@
+"""Multi-currency support for ledgerlite.
+
+`RATES` gives, for each supported non-USD currency code, how many US
+dollars one unit of that currency is worth (e.g. `RATES["EUR"] = 1.09`
+means 1 EUR = 1.09 USD). USD is the implicit base currency and is not a
+key in `RATES`.
+
+Rounding rule (load-bearing for every feature that converts currencies --
+do not change without updating every caller): every conversion result is
+rounded to exactly 2 decimal places using `decimal.ROUND_HALF_UP` (halfway
+values always round away from zero, e.g. 17.145 -> 17.15), applied ONCE to
+the final result of a conversion, never to an intermediate USD amount.
+"""
+
+from __future__ import annotations
+
+from decimal import Decimal, ROUND_HALF_UP
+from typing import Dict
+
+#: USD value of one unit of each supported non-USD currency.
+RATES: Dict[str, Decimal] = {
+    "EUR": Decimal("1.09"),
+    "GBP": Decimal("1.27"),
+}
+
+BASE_CURRENCY = "USD"
+
+_CENTS = Decimal("0.01")
+
+
+def _round(amount: Decimal) -> Decimal:
+    return amount.quantize(_CENTS, rounding=ROUND_HALF_UP)
+
+
+def to_usd(amount: Decimal, currency: str) -> Decimal:
+    """Convert `amount` (denominated in `currency`) to USD.
+
+    Raises `KeyError` if `currency` is neither `"USD"` nor a key of
+    `RATES`.
+    """
+    if currency == BASE_CURRENCY:
+        return _round(amount)
+    rate = RATES[currency]
+    return _round(amount * rate)
+
+
+def from_usd(amount: Decimal, currency: str) -> Decimal:
+    """Convert a USD `amount` to `currency`.
+
+    Raises `KeyError` if `currency` is neither `"USD"` nor a key of
+    `RATES`.
+    """
+    if currency == BASE_CURRENCY:
+        return _round(amount)
+    rate = RATES[currency]
+    return _round(amount / rate)
+
+
+def convert(amount: Decimal, from_currency: str, to_currency: str) -> Decimal:
+    """Convert `amount` from `from_currency` to `to_currency`, via USD.
+
+    The USD intermediate is kept at full precision; only the final result
+    is rounded (see module docstring). Raises `KeyError` if either
+    currency is neither `"USD"` nor a key of `RATES`.
+    """
+    if from_currency == to_currency:
+        return _round(amount)
+    usd = amount if from_currency == BASE_CURRENCY else amount * RATES[from_currency]
+    result = usd if to_currency == BASE_CURRENCY else usd / RATES[to_currency]
+    return _round(result)
