@@ -0,0 +1,26 @@
+"""Per-category monthly budgets for ledgerlite."""
+
+from __future__ import annotations
+
+from decimal import Decimal
+from pathlib import Path
+from typing import Dict, Union
+
+from . import store
+
+BUDGETS_KEY = "budgets"
+
+
+def load_budgets(path: Union[str, Path]) -> Dict[str, Decimal]:
+    raw = store.load_key(path, BUDGETS_KEY, default={})
+    return {category: Decimal(limit) for category, limit in raw.items()}
+
+
+def save_budgets(path: Union[str, Path], budgets: Dict[str, Decimal]) -> None:
+    store.save_key(path, BUDGETS_KEY, {category: str(limit) for category, limit in budgets.items()})
+
+
+def set_budget(path: Union[str, Path], category: str, limit: Decimal) -> None:
+    budgets = load_budgets(path)
+    budgets[category] = limit
+    save_budgets(path, budgets)
