+"""The `fx` command family."""
+
+from __future__ import annotations
+
+import argparse
+from decimal import Decimal
+
+from .. import currency
+
+
+def add_subparser(sub: argparse._SubParsersAction) -> None:
+    p_fx = sub.add_parser("fx", help="currency conversion helpers")
+    fx_sub = p_fx.add_subparsers(dest="fx_command", required=True)
+    p_fx_convert = fx_sub.add_parser("convert", help="convert an amount between currencies")
+    p_fx_convert.add_argument("amount", help="amount to convert")
+    p_fx_convert.add_argument("from_currency", metavar="FROM", help="source currency code")
+    p_fx_convert.add_argument("to_currency", metavar="TO", help="destination currency code")
