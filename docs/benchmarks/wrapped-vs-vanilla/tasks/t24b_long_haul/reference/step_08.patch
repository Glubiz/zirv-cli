@@ -0,0 +1,101 @@
+"""Recurring transaction rules for ledgerlite.
+
+A rule fires once per calendar month, on a fixed day-of-month, generating
+one `Transaction`. To sidestep short-month edge cases entirely, `day` must
+be between 1 and 28 inclusive (every month has at least 28 days) -- this
+is enforced by the CLI layer, not here.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+from typing import List, Optional, Union
+
+from . import store
+from .models import Transaction
+
+RECURRING_KEY = "recurring"
+
+
+@dataclass
+class RecurringRule:
+    payee: str
+    amount: Decimal
+    day: int
+    category: Optional[str] = None
+    currency: str = "USD"
+    memo: str = ""
+
+
+def _rule_to_dict(rule: RecurringRule) -> dict:
+    return {
+        "payee": rule.payee,
+        "amount": str(rule.amount),
+        "day": rule.day,
+        "category": rule.category,
+        "currency": rule.currency,
+        "memo": rule.memo,
+    }
+
+
+def _rule_from_dict(data: dict) -> RecurringRule:
+    return RecurringRule(
+        payee=data["payee"],
+        amount=Decimal(data["amount"]),
+        day=data["day"],
+        category=data.get("category"),
+        currency=data.get("currency") or "USD",
+        memo=data.get("memo") or "",
+    )
+
+
+def load_rules(path: Union[str, Path]) -> List[RecurringRule]:
+    raw = store.load_key(path, RECURRING_KEY, default=[])
+    return [_rule_from_dict(d) for d in raw]
+
+
+def save_rules(path: Union[str, Path], rules: List[RecurringRule]) -> None:
+    store.save_key(path, RECURRING_KEY, [_rule_to_dict(r) for r in rules])
+
+
+def _months_between(from_year: int, from_month: int, to_year: int, to_month: int):
+    y, m = from_year, from_month
+    while (y, m) <= (to_year, to_month):
+        yield y, m
+        m += 1
+        if m > 12:
+            m = 1
+            y += 1
+
+
+def generate(
+    rules: List[RecurringRule],
+    from_year: int, from_month: int,
+    to_year: int, to_month: int,
+    start_id: int,
+) -> List[Transaction]:
+    """One `Transaction` per rule per calendar month in the inclusive
+    `[from_year-from_month, to_year-to_month]` range, in rule order within
+    each month, months in chronological order. Ids are assigned
+    sequentially starting at `start_id`, in the same order.
+    """
+    txns: List[Transaction] = []
+    next_id = start_id
+    for year, month in _months_between(from_year, from_month, to_year, to_month):
+        for rule in rules:
+            txns.append(
+                Transaction(
+                    id=next_id,
+                    date=date(year, month, rule.day),
+                    amount=rule.amount,
+                    payee=rule.payee,
+                    memo=rule.memo,
+                    category=rule.category,
+                    currency=rule.currency,
+                )
+            )
+            next_id += 1
+    return txns
