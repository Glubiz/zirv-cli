+"""The `reconcile` command family."""
+
+from __future__ import annotations
+
+import argparse
+from decimal import Decimal
+
+from ..reconcile import cleared_total, load_cleared, mark_cleared
+from ..store import load
+from . import DEFAULT_STORE
+
+
+def add_subparser(sub: argparse._SubParsersAction) -> None:
+    p_reconcile = sub.add_parser("reconcile", help="bank reconciliation")
+    reconcile_sub = p_reconcile.add_subparsers(dest="reconcile_command", required=True)
+    p_rec_mark = reconcile_sub.add_parser("mark", help="mark transactions as cleared")
+    p_rec_mark.add_argument("ids", nargs="+", type=int, metavar="ID")
+    p_rec_mark.add_argument("--store", default=DEFAULT_STORE)
+    p_rec_status = reconcile_sub.add_parser("status", help="compare cleared total to a statement balance")
+    p_rec_status.add_argument("--statement-balance", dest="statement_balance", required=True)
+    p_rec_status.add_argument("--store", default=DEFAULT_STORE)
+
+
+def _cmd_reconcile(args: argparse.Namespace) -> int:
+    if args.reconcile_command == "mark":
+        mark_cleared(args.store, args.ids)
+        print(f"Marked {len(args.ids)} transactions as cleared")
+        return 0
+    if args.reconcile_command == "status":
+        txns = load(args.store)
+        cleared_ids = load_cleared(args.store)
+        total = cleared_total(txns, cleared_ids)
+        statement_balance = Decimal(args.statement_balance)
+        difference = statement_balance - total
+        print(f"Cleared total: {total:.2f}")
+        print(f"Statement balance: {statement_balance:.2f}")
+        print(f"Difference: {difference:.2f}")
+        print(f"Status: {'reconciled' if difference == 0 else 'out of balance'}")
+        return 0
+    raise ValueError(f"unknown reconcile command: {args.reconcile_command!r}")
+
+
+HANDLERS = {"reconcile": _cmd_reconcile}
