+    recurring rules, reconciliation state, undo history, ...) instead of
+    clobbering it -- only the `"transactions"` key is replaced.
+    """
+    raw = _load_raw(path)
+    raw["transactions"] = [_txn_to_dict(t) for t in txns]
+    _write_raw(path, raw)
