@@ -0,0 +1,10 @@
+"""Each `ledgerlite.commands.*` module owns one command family: it adds its
+own subparser(s) to the shared top-level parser via `add_subparser(sub)`
+and exposes a `HANDLERS` dict mapping command name -> handler function.
+`ledgerlite.cli` collects both across every module in `MODULES` below --
+this is a pure reorganisation of `cli.py`, behavior is unchanged.
+"""
+
+from __future__ import annotations
+
+DEFAULT_STORE = "ledger.json"
