+def next_id(txns: List[Transaction]) -> int:
+    """The id to assign to the next NEW transaction appended to `txns`:
+    one past the highest id already present, or `1` if `txns` is empty.
+
+    Every feature that ADDS transactions to an existing store (append
+    imports, OFX imports, recurring rules, batch imports, ...) uses this
+    same rule, so ids stay unique and monotonically increasing across the
