@@ -0,0 +1,40 @@
+"""The `budget` command family."""
+
+from __future__ import annotations
+
+import argparse
+from decimal import Decimal
+
+from ..budgets import load_budgets, set_budget
+from . import DEFAULT_STORE
+
+
+def add_subparser(sub: argparse._SubParsersAction) -> None:
+    p_budget = sub.add_parser("budget", help="per-category monthly budgets")
+    budget_sub = p_budget.add_subparsers(dest="budget_command", required=True)
+    p_budget_set = budget_sub.add_parser("set", help="set (or replace) a category's budget")
+    p_budget_set.add_argument("--category", required=True)
+    p_budget_set.add_argument("--limit", required=True)
+    p_budget_set.add_argument("--store", default=DEFAULT_STORE)
+    p_budget_list = budget_sub.add_parser("list", help="list saved budgets")
+    p_budget_list.add_argument("--store", default=DEFAULT_STORE)
+
+
+def _cmd_budget(args: argparse.Namespace) -> int:
+    if args.budget_command == "set":
+        limit = Decimal(args.limit)
+        set_budget(args.store, args.category, limit)
+        print(f"Set budget for {args.category}: {limit:.2f}")
+        return 0
+    if args.budget_command == "list":
+        budgets = load_budgets(args.store)
+        if not budgets:
+            print("No budgets.")
+            return 0
+        for category in sorted(budgets):
+            print(f"{category}: {budgets[category]:.2f}")
+        return 0
+    raise ValueError(f"unknown budget command: {args.budget_command!r}")
+
+
+HANDLERS = {"budget": _cmd_budget}
diff --git a/ledgerlite/commands/core.py b/ledgerlite/commands/core.py
new file mode 100644
index 0000000..0561033
--- /dev/null
+++ b/ledgerlite/commands/core.py
@@ -0,0 +1,149 @@
+"""The original core commands: import, list, summary, categorize."""
+
+from __future__ import annotations
+
+import argparse
+from decimal import Decimal
+
+from .. import report
+from ..budgets import load_budgets
+from ..parse import read_csv
+from ..rules import DEFAULT_RULES, categorize
+from ..store import load, next_id, save
+from . import DEFAULT_STORE
+
+
+def add_subparser(sub: argparse._SubParsersAction) -> None:
+    p_import = sub.add_parser("import", help="import transactions from a CSV file")
+    p_import.add_argument("csv_path", help="path to a bank-export CSV file")
+    p_import.add_argument(
+        "--store", default=DEFAULT_STORE, help="ledger JSON file to write (default: %(default)s)"
+    )
+    p_import.add_argument(
+        "--currency", default="USD",
+        help="currency for rows with no currency column of their own (default: %(default)s)",
+    )
+    p_import.add_argument(
+        "--append", action="store_true",
+        help="add to the existing store instead of replacing it (default: replace)",
+    )
+
+    p_list = sub.add_parser("list", help="list stored transactions")
+    p_list.add_argument(
+        "--store", default=DEFAULT_STORE, help="ledger JSON file to read (default: %(default)s)"
+    )
+    p_list.add_argument("--page", type=int, default=1, help="page number, 1-indexed (default: %(default)s)")
+    p_list.add_argument(
+        "--page-size", type=int, default=10, dest="page_size", help="rows per page (default: %(default)s)"
+    )
+    p_list.add_argument(
+        "--legacy-order", action="store_true", dest="legacy_order",
+        help="keep the old raw store order (ascending id) instead of the default most-recent-first",
+    )
+
+    p_summary = sub.add_parser("summary", help="show per-category totals")
+    p_summary.add_argument(
+        "--store", default=DEFAULT_STORE, help="ledger JSON file to read (default: %(default)s)"
+    )
+    p_summary.add_argument(
+        "--vs-budget", action="store_true", dest="vs_budget",
+        help="show each category's budget and remaining amount instead of its share",
+    )
+
+    p_categorize = sub.add_parser(
+        "categorize", help="(re)apply the default rules to stored transactions"
+    )
+    p_categorize.add_argument(
+        "--store", default=DEFAULT_STORE, help="ledger JSON file to update (default: %(default)s)"
+    )
+
+
+def _parse_year_month(text: str):
+    year_str, month_str = text.split("-", 1)
+    return int(year_str), int(month_str)
+
+
+def _cmd_import(args: argparse.Namespace) -> int:
+    existing = load(args.store) if args.append else []
+    start_id = next_id(existing) if args.append else 1
+    new_txns = read_csv(args.csv_path, default_currency=args.currency, start_id=start_id)
+    for txn in new_txns:
+        if txn.category is None:
+            txn.category = categorize(txn, DEFAULT_RULES)
+    save(args.store, existing + new_txns)
+    print(f"Imported {len(new_txns)} transactions into {args.store}")
+    return 0
+
+
+def _cmd_list(args: argparse.Namespace) -> int:
+    txns = load(args.store)
+    if not args.legacy_order:
+        # Most-recent-first by date; ties broken by id ascending. Python's
+        # sort is stable, so sorting by id first and then (stably) by date
+        # gives exactly that tie-break without a compound key.
+        txns = sorted(txns, key=lambda t: t.id)
+        txns = sorted(txns, key=lambda t: t.date, reverse=True)
+    rows = report.page(txns, args.page, args.page_size)
+    if not rows:
+        print("No transactions on this page.")
+        return 0
+    print(f"{'ID':>4}  {'Date':<10}  {'Amount':>10}  {'Payee':<24}  {'Category':<14}  Memo")
+    for txn in rows:
+        print(
+            f"{txn.id:>4}  {txn.date.isoformat():<10}  {txn.amount:>10}  "
+            f"{txn.payee:<24}  {(txn.category or ''):<14}  {txn.memo}"
+        )
+    return 0
+
+
+def _cmd_summary(args: argparse.Namespace) -> int:
+    txns = load(args.store)
+
+    # NOTE: this re-derives per-category totals and percent share instead of
+    # calling report.category_totals()/report.summarize() -- see D5.
+    totals: dict = {}
+    for txn in txns:
+        key = txn.category or report.UNCATEGORIZED
+        totals[key] = totals.get(key, Decimal("0")) + txn.amount
+
+    if args.vs_budget:
+        budgets = load_budgets(args.store)
+        print(f"{'Category':<14}  {'Total':>10}  {'Budget':>10}  {'Remaining':>10}")
+        for category, amount in sorted(totals.items()):
+            limit = budgets.get(category)
+            if limit is None:
+                budget_disp = "-"
+                remaining_disp = "-"
+            else:
+                budget_disp = f"{limit:.2f}"
+                remaining_disp = f"{(limit - abs(amount)):.2f}"
+            print(f"{category:<14}  {amount:>10}  {budget_disp:>10}  {remaining_disp:>10}")
+        return 0
+
+    magnitude_sum = sum((abs(v) for v in totals.values()), Decimal("0"))
+    print(f"{'Category':<14}  {'Total':>10}  {'Share':>7}")
+    for category, amount in sorted(totals.items()):
+        percent = (abs(amount) / magnitude_sum * 100) if magnitude_sum else Decimal("0")
+        print(f"{category:<14}  {amount:>10}  {percent:>6.1f}%")
+    return 0
+
+
+def _cmd_categorize(args: argparse.Namespace) -> int:
+    txns = load(args.store)
+    changed = 0
+    for txn in txns:
+        new_category = categorize(txn, DEFAULT_RULES)
+        if new_category != txn.category:
+            txn.category = new_category
+            changed += 1
+    save(args.store, txns)
+    print(f"Re-categorized {changed} of {len(txns)} transactions")
+    return 0
+
+
+HANDLERS = {
+    "import": _cmd_import,
+    "list": _cmd_list,
+    "summary": _cmd_summary,
+    "categorize": _cmd_categorize,
+}
