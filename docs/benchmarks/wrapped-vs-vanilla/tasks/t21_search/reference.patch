         by_category[category] = {"total": amount, "percent": percent}
 
     return {"count": len(txns), "net": net, "by_category": by_category}
+
+
+def search(
+    txns: List[Transaction],
+    payee_contains: Optional[str] = None,
+    min_amount: Optional[Decimal] = None,
+    max_amount: Optional[Decimal] = None,
+    category: Optional[str] = None,
+    uncategorized_only: bool = False,
+    date_from: Optional[date_cls] = None,
+    date_to: Optional[date_cls] = None,
+) -> List[Transaction]:
+    """Filter `txns` by every given criterion (AND), preserving order."""
+    result = []
+    for txn in txns:
+        if payee_contains is not None and payee_contains.lower() not in txn.payee.lower():
+            continue
+        if min_amount is not None and txn.amount < min_amount:
+            continue
+        if max_amount is not None and txn.amount > max_amount:
+            continue
+        if category is not None and txn.category != category:
+            continue
+        if uncategorized_only and txn.category is not None:
+            continue
+        if date_from is not None and txn.date < date_from:
+            continue
+        if date_to is not None and txn.date > date_to:
+            continue
+        result.append(txn)
+    return result
