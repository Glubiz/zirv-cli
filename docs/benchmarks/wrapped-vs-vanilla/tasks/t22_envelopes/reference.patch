@@ -0,0 +1,44 @@
+"""Proportional income allocation across envelopes (largest-remainder method)."""
+
+from __future__ import annotations
+
+from decimal import ROUND_DOWN, Decimal
+from typing import Dict, List
+
+from .envelopes import Envelope
+
+CENT = Decimal("0.01")
+
+
+def suggest_allocations(envelopes: List[Envelope], total_income: Decimal) -> Dict[str, Decimal]:
+    """Split `total_income` across `envelopes` proportionally to `monthly_budget`.
+
+    Uses the largest-remainder method so the result always sums to exactly
+    `total_income` (to the cent): each envelope's exact share is floored to
+    2 decimals, then the leftover cents are handed out one at a time to the
+    envelopes with the largest fractional remainder, ties broken
+    alphabetically by name. If every envelope's `monthly_budget` is 0 (or
+    there are no envelopes), every result is `Decimal("0.00")`.
+    """
+    total_budget = sum((e.monthly_budget for e in envelopes), Decimal("0"))
+    if not envelopes or total_budget == 0:
+        return {e.name: Decimal("0.00") for e in envelopes}
+
+    exact: Dict[str, Decimal] = {}
+    floors: Dict[str, Decimal] = {}
+    remainders: Dict[str, Decimal] = {}
+    for e in envelopes:
+        share = (total_income * e.monthly_budget / total_budget)
+        floor = share.quantize(CENT, rounding=ROUND_DOWN)
+        exact[e.name] = share
+        floors[e.name] = floor
+        remainders[e.name] = share - floor
+
+    allocated = sum(floors.values(), Decimal("0"))
+    leftover_cents = int((total_income - allocated) / CENT)
+
+    order = sorted(envelopes, key=lambda e: (-remainders[e.name], e.name))
+    result = dict(floors)
+    for e in order[:leftover_cents]:
+        result[e.name] += CENT
+    return result
