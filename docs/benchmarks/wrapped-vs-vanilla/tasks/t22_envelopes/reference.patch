index 0000000..c9ed28e
--- /dev/null
+++ b/ledgerlite/envelopes.py
@@ -0,0 +1,100 @@
+"""Envelope budgeting model for ledgerlite.
+
+An `Envelope` budgets a fixed amount per month against one or more
+categories. `spent_in_month`/`balance_through_month` are pure: no I/O, no
+clock -- persistence lives in `envelope_store.py`, CLI wiring in
+`envelope_cli.py`.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from decimal import Decimal
+from typing import Dict, List, Optional
+
+from .models import Transaction
+
+_MONTH_RE = re.compile(r"^\d{4}-\d{2}$")
+
+
+@dataclass
+class Envelope:
+    name: str
+    categories: List[str]
+    monthly_budget: Decimal
+    start_month: str
+    rollover: bool = False
+    starting_balance: Decimal = Decimal("0")
+    closed_through: Optional[str] = None
+    adjustments: Dict[str, Decimal] = field(default_factory=dict)
+
+
+def is_valid_month(text: str) -> bool:
+    """Whether `text` is a well-formed `"YYYY-MM"` month string."""
+    return bool(_MONTH_RE.match(text))
+
+
+def _parse_month(text: str):
+    y, m = text.split("-")
+    return int(y), int(m)
+
+
+def _month_str(year: int, month: int) -> str:
+    return f"{year:04d}-{month:02d}"
+
+
+def _next_month(year: int, month: int):
+    return (year + 1, 1) if month == 12 else (year, month + 1)
+
+
+def spent_in_month(envelope: Envelope, txns: List[Transaction], year: int, month: int) -> Decimal:
+    """Sum of `abs(amount)` for transactions in `envelope.categories`, that month."""
+    total = Decimal("0")
+    wanted = set(envelope.categories)
+    for txn in txns:
+        if txn.category in wanted and txn.date.year == year and txn.date.month == month:
+            total += abs(txn.amount)
+    return total
+
+
+def balance_through_month(envelope: Envelope, txns: List[Transaction], year: int, month: int) -> Decimal:
+    """The envelope's remaining balance for `year`-`month`.
+
+    Raises `ValueError` for a month before `start_month` (or before
+    `closed_through`, once set) -- see envelopes.py's module docstring and
+    the task prompt for the exact rules.
+    """
+    target = (year, month)
+    start = _parse_month(envelope.start_month)
+
+    if not envelope.rollover:
+        if target < start:
+            raise ValueError(f"{_month_str(*target)} is before start_month {envelope.start_month}")
+        spent = spent_in_month(envelope, txns, year, month)
+        adj = envelope.adjustments.get(_month_str(year, month), Decimal("0"))
+        return envelope.monthly_budget - spent + adj
+
+    if envelope.closed_through:
+        closed = _parse_month(envelope.closed_through)
+        if target < closed:
+            raise ValueError(f"{_month_str(*target)} is before closed_through {envelope.closed_through}")
+        if target == closed:
+            return envelope.starting_balance
+        base = _next_month(*closed)
+    else:
+        if target < start:
+            raise ValueError(f"{_month_str(*target)} is before start_month {envelope.start_month}")
+        base = start
+
+    running = envelope.starting_balance
+    cur = base
+    while True:
+        y, m = cur
+        spent = spent_in_month(envelope, txns, y, m)
+        adj = envelope.adjustments.get(_month_str(y, m), Decimal("0"))
+        running = running + envelope.monthly_budget - spent + adj
+        if (y, m) == target:
+            break
+        cur = _next_month(y, m)
+    return running
