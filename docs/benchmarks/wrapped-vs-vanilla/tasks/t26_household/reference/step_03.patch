diff --git a/ledgerlite/household.py b/ledgerlite/household.py
new file mode 100644
index 0000000..f71fd43
--- /dev/null
+++ b/ledgerlite/household.py
@@ -0,0 +1,127 @@
+"""Household sharing for ledgerlite: members, shared expenses and transfers.
+
+Everything here works on the plain dict that `store.load_data` returns, so
+the functions stay easy to test and the CLI layer only does I/O.
+"""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import InvalidOperation
+from typing import Dict, List, Optional
+
+from .models import parse_money
+
+
+class HouseholdError(Exception):
+    """A user-facing problem; the CLI prints `error: <message>` and exits 2."""
+
+
+def member_names(data: dict) -> List[str]:
+    return list(data.get("members", []))
+
+
+def find_member(data: dict, name: str) -> str:
+    """Return the stored spelling of member `name` (case-insensitive match)."""
+    wanted = name.strip().lower()
+    for member in member_names(data):
+        if member.lower() == wanted:
+            return member
+    raise HouseholdError(f"unknown member: {name}")
+
+
+def add_member(data: dict, name: str) -> str:
+    name = name.strip()
+    if not name:
+        raise HouseholdError("member name cannot be empty")
+    if any(m.lower() == name.lower() for m in member_names(data)):
+        raise HouseholdError(f"member already exists: {name}")
+    data.setdefault("members", []).append(name)
+    return name
+
+
+def parse_cents(text: str) -> int:
+    """Parse a money amount typed by the user into integer cents."""
+    try:
+        value = parse_money(text)
+        return int(value * 100)
+    except (InvalidOperation, ValueError):
+        raise HouseholdError(f"invalid amount: {text}")
+
+
+def format_cents(cents: int) -> str:
+    sign = "-" if cents < 0 else ""
+    return f"{sign}{abs(cents) // 100}.{abs(cents) % 100:02d}"
+
+
+def parse_date(text: Optional[str]) -> str:
+    if text is None:
+        return date.today().isoformat()
+    try:
+        return date.fromisoformat(text).isoformat()
+    except ValueError:
+        raise HouseholdError(f"invalid date: {text}")
+
+
+def split_cents(total: int, weights: Dict[str, int]) -> Dict[str, int]:
+    """Split `total` cents in proportion to `weights`.
+
+    Each share is rounded down to a whole cent; the cents left over are then
+    handed out one at a time, starting with the first participant.
+    """
+    names = list(weights)
+    weight_sum = sum(weights.values())
+    shares = {n: total * weights[n] // weight_sum for n in names}
+    leftover = total - sum(shares.values())
+    for name in names[:leftover]:
+        shares[name] += 1
+    return shares
+
+
+def expenses(data: dict) -> List[dict]:
+    return data.setdefault("expenses", [])
+
+
+def find_expense(data: dict, expense_id: int) -> dict:
+    for exp in expenses(data):
+        if exp["id"] == expense_id:
+            return exp
+    raise HouseholdError(f"no such expense: {expense_id}")
+
+
+def parse_split(data: dict, text: str) -> Dict[str, int]:
+    """Parse `NAME=WEIGHT,NAME=WEIGHT` into {stored member name: weight}."""
+    weights: Dict[str, int] = {}
+    for part in text.split(","):
+        name, sep, raw = part.partition("=")
+        if not sep or not raw.strip().isdigit() or int(raw) <= 0:
+            raise HouseholdError(f"invalid split: {text}")
+        member = find_member(data, name)
+        if member in weights:
+            raise HouseholdError(f"duplicate member in split: {name.strip()}")
+        weights[member] = int(raw)
+    return weights
+
+
+def add_expense(data: dict, payer: str, amount: str, description: str,
+                on: Optional[str] = None, split: Optional[str] = None) -> dict:
+    payer = find_member(data, payer)
+    cents = parse_cents(amount)
+    if cents <= 0:
+        raise HouseholdError("amount must be positive")
+    day = parse_date(on)
+    if split is None:
+        weights = {name: 1 for name in member_names(data)}
+    else:
+        weights = parse_split(data, split)
+    expense = {
+        "id": max((e["id"] for e in expenses(data)), default=0) + 1,
+        "date": day,
+        "payer": payer,
+        "amount": cents,
+        "description": description,
+        "weights": weights,
+        "shares": split_cents(cents, weights),
+    }
+    expenses(data).append(expense)
+    return expense
