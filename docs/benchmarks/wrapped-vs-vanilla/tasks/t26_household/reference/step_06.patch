index 0000000..af921ff
--- /dev/null
+++ b/ledgerlite/household.py
@@ -0,0 +1,219 @@
+"""Household sharing for ledgerlite: members, shared expenses and transfers.
+
+Everything here works on the plain dict that `store.load_data` returns, so
+the functions stay easy to test and the CLI layer only does I/O.
+"""
+
+from __future__ import annotations
+
+from datetime import date
+from decimal import InvalidOperation
+from typing import Dict, List, Optional, Tuple
+
+from .models import parse_money
+
+
+class HouseholdError(Exception):
+    """A user-facing problem; the CLI prints `error: <message>` and exits 2."""
+
+
+def member_names(data: dict) -> List[str]:
+    return list(data.get("members", []))
+
+
+def find_member(data: dict, name: str) -> str:
+    """Return the stored spelling of member `name` (case-insensitive match)."""
+    wanted = name.strip().lower()
+    for member in member_names(data):
+        if member.lower() == wanted:
+            return member
+    raise HouseholdError(f"unknown member: {name}")
+
+
+def add_member(data: dict, name: str) -> str:
+    name = name.strip()
+    if not name:
+        raise HouseholdError("member name cannot be empty")
+    if any(m.lower() == name.lower() for m in member_names(data)):
+        raise HouseholdError(f"member already exists: {name}")
+    data.setdefault("members", []).append(name)
+    return name
+
+
+def parse_cents(text: str) -> int:
+    """Parse a money amount typed by the user into integer cents."""
+    try:
+        value = parse_money(text)
+        return int(value * 100)
+    except (InvalidOperation, ValueError):
+        raise HouseholdError(f"invalid amount: {text}")
+
+
+def parse_positive_cents(text: str) -> int:
+    cents = parse_cents(text)
+    if cents <= 0:
+        raise HouseholdError("amount must be positive")
+    return cents
+
+
+def format_cents(cents: int) -> str:
+    sign = "-" if cents < 0 else ""
+    return f"{sign}{abs(cents) // 100}.{abs(cents) % 100:02d}"
+
+
+def parse_date(text: Optional[str]) -> str:
+    if text is None:
+        return date.today().isoformat()
+    try:
+        return date.fromisoformat(text).isoformat()
+    except ValueError:
+        raise HouseholdError(f"invalid date: {text}")
+
+
+def split_cents(total: int, weights: Dict[str, int]) -> Dict[str, int]:
+    """Split `total` cents in proportion to `weights`.
+
+    Each share is rounded down to a whole cent; the cents left over are then
+    handed out one at a time, starting with the first participant.
+    """
+    names = list(weights)
+    weight_sum = sum(weights.values())
+    shares = {n: total * weights[n] // weight_sum for n in names}
+    leftover = total - sum(shares.values())
+    for name in names[:leftover]:
+        shares[name] += 1
+    return shares
+
+
+def expenses(data: dict) -> List[dict]:
+    return data.setdefault("expenses", [])
+
+
+def find_expense(data: dict, expense_id: int) -> dict:
+    for exp in expenses(data):
+        if exp["id"] == expense_id:
+            return exp
+    raise HouseholdError(f"no such expense: {expense_id}")
+
+
+def parse_split(data: dict, text: str) -> Dict[str, int]:
+    """Parse `NAME=WEIGHT,NAME=WEIGHT` into {stored member name: weight}."""
+    weights: Dict[str, int] = {}
+    for part in text.split(","):
+        name, sep, raw = part.partition("=")
+        if not sep or not raw.strip().isdigit() or int(raw) <= 0:
+            raise HouseholdError(f"invalid split: {text}")
+        member = find_member(data, name)
+        if member in weights:
+            raise HouseholdError(f"duplicate member in split: {name.strip()}")
+        weights[member] = int(raw)
+    return weights
+
+
+def add_expense(data: dict, payer: str, amount: str, description: str,
+                on: Optional[str] = None, split: Optional[str] = None) -> dict:
+    payer = find_member(data, payer)
+    cents = parse_positive_cents(amount)
+    day = parse_date(on)
+    if split is None:
+        weights = {name: 1 for name in member_names(data)}
+    else:
+        weights = parse_split(data, split)
+    expense = {
+        "id": max((e["id"] for e in expenses(data)), default=0) + 1,
+        "date": day,
+        "payer": payer,
+        "amount": cents,
+        "description": description,
+        "weights": weights,
+        "shares": split_cents(cents, weights),
+    }
+    expenses(data).append(expense)
+    return expense
+
+
+def balances(data: dict) -> Dict[str, int]:
+    """Net balance in cents per member, in member order.
+
+    Positive means the household owes the member (they paid more than their
+    share); negative means the member owes the household.
+    """
+    result = {name: 0 for name in member_names(data)}
+    for exp in expenses(data):
+        result[exp["payer"]] = result.get(exp["payer"], 0) + exp["amount"]
+        for name, share in exp["shares"].items():
+            result[name] = result.get(name, 0) - share
+    # A transfer is the sender paying the receiver back: the sender's balance
+    # goes up by the amount, the receiver's goes down.
+    for transfer in transfers(data):
+        for entry in transfer["entries"]:
+            result[entry["member"]] = result.get(entry["member"], 0) - entry["amount"]
+    return result
+
+
+def suggest_settlements(data: dict) -> List[Tuple[str, str, int]]:
+    """Greedy settle-up plan: a list of (payer, receiver, cents).
+
+    Repeatedly the member who owes the most pays the member who is owed the
+    most, as much as they can cover; ties go to whoever was added first.
+    """
+    order = {name: i for i, name in enumerate(balances(data))}
+    owes = {n: -c for n, c in balances(data).items() if c < 0}
+    owed = {n: c for n, c in balances(data).items() if c > 0}
+    plan: List[Tuple[str, str, int]] = []
+    while owes and owed:
+        debtor = min(owes, key=lambda n: (-owes[n], order[n]))
+        creditor = min(owed, key=lambda n: (-owed[n], order[n]))
+        pay = min(owes[debtor], owed[creditor])
+        plan.append((debtor, creditor, pay))
+        owes[debtor] -= pay
+        owed[creditor] -= pay
+        if owes[debtor] == 0:
+            del owes[debtor]
+        if owed[creditor] == 0:
+            del owed[creditor]
+    return plan
+
+
+def transfers(data: dict) -> List[dict]:
+    return data.setdefault("transfers", [])
+
+
+def add_transfer(data: dict, sender: str, receiver: str, amount: str,
+                 note: str = "", on: Optional[str] = None) -> dict:
+    """Record money handed from `sender` to `receiver` as a pair of entries."""
+    sender = find_member(data, sender)
+    receiver = find_member(data, receiver)
+    if sender == receiver:
+        raise HouseholdError("cannot transfer to the same member")
+    cents = parse_positive_cents(amount)
+    day = parse_date(on)
+    transfer = {
+        "id": max((t["id"] for t in transfers(data)), default=0) + 1,
+        "date": day,
+        "note": note,
+        "entries": [
+            {"member": sender, "amount": -cents},
+            {"member": receiver, "amount": cents},
+        ],
+    }
+    transfers(data).append(transfer)
+    return transfer
+
+
+def transfer_parties(transfer: dict) -> Tuple[str, str, int]:
+    """(sender, receiver, cents) of a transfer."""
+    out, into = transfer["entries"]
+    return out["member"], into["member"], into["amount"]
+
+
+def account_entries(data: dict, name: str) -> List[Tuple[int, int, str]]:
+    """(transfer id, signed cents, other member) for every entry of `name`."""
+    name = find_member(data, name)
+    rows = []
+    for transfer in transfers(data):
+        first, second = transfer["entries"]
+        for mine, other in ((first, second), (second, first)):
+            if mine["member"] == name:
+                rows.append((transfer["id"], mine["amount"], other["member"]))
+    return rows
