@@ -0,0 +1,50 @@
+"""A small service layer wrapping a single ledger store file.
+
+Pulls the load/modify/save logic shared by the `import` and `categorize`
+CLI commands into one reusable place.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import List, Union
+
+from .models import Transaction
+from .parse import read_csv
+from .rules import DEFAULT_RULES, categorize
+from .store import load as _store_load
+from .store import save as _store_save
+
+
+class Ledger:
+    """A ledger store at a fixed path, with import/categorize helpers."""
+
+    def __init__(self, path: Union[str, Path]):
+        self.path = path
+
+    def load(self) -> List[Transaction]:
+        return _store_load(self.path)
+
+    def save(self, txns: List[Transaction]) -> None:
+        _store_save(self.path, txns)
+
+    def import_csv(self, csv_path, rules=DEFAULT_RULES) -> int:
+        """Import `csv_path`, categorize uncategorized rows, save, return count."""
+        txns = read_csv(csv_path)
+        for txn in txns:
+            if txn.category is None:
+                txn.category = categorize(txn, rules)
+        self.save(txns)
+        return len(txns)
+
+    def categorize_all(self, rules=DEFAULT_RULES) -> int:
+        """Re-apply `rules` to every stored transaction; return how many changed."""
+        txns = self.load()
+        changed = 0
+        for txn in txns:
+            new_category = categorize(txn, rules)
+            if new_category != txn.category:
+                txn.category = new_category
+                changed += 1
+        self.save(txns)
+        return changed
