@@ -0,0 +1,43 @@
+"""Savings/spending goals for ledgerlite."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import date
+from decimal import Decimal
+from typing import List, Optional
+
+from .models import Transaction
+
+
+@dataclass
+class Goal:
+    """A savings/spending goal tracked against one or more categories."""
+
+    name: str
+    target: Decimal
+    categories: List[str]
+    target_date: Optional[date] = None
+    milestones: List[int] = field(default_factory=list)
+
+
+def progress(goal: Goal, txns: List[Transaction]) -> Decimal:
+    """Sum of `abs(amount)` over every transaction matching `goal.categories`."""
+    total = Decimal("0")
+    wanted = set(goal.categories)
+    for txn in txns:
+        if txn.category in wanted:
+            total += abs(txn.amount)
+    return total
+
+
+def _percent(goal: Goal, txns: List[Transaction]) -> Decimal:
+    if goal.target == 0:
+        return Decimal("0")
+    return progress(goal, txns) / goal.target * 100
+
+
+def reached_milestones(goal: Goal, txns: List[Transaction]) -> List[int]:
+    """Milestones from `goal.milestones` whose threshold has been reached."""
+    percent = _percent(goal, txns)
+    return sorted(m for m in goal.milestones if percent >= m)
